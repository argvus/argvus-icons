pkgname=argvus-icons
pkgver=0.1.0
pkgrel=1
pkgdesc="Argvus icon themes based on Adwaita"
arch=('any')
url="https://github.com/argvus/argvus-icons"
license=('GPL-3.0-only')
depends=('adwaita-icon-theme' 'hicolor-icon-theme')
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=()

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

check() {
	arch_check_icons_payload
}

package() {
	arch_package_icons_payload
}
